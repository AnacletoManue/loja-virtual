"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";

export default function ConsultarPedidoPage() {
  const [searchQuery, setSearchQuery] = useState("");
  const [phone, setPhone] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const router = useRouter();

  async function handleSearch(e: React.FormEvent) {
    e.preventDefault();
    setError("");

    if (!searchQuery.trim() || !phone.trim()) {
      setError("Por favor, preencha o número do pedido e o seu telefone.");
      return;
    }

    setLoading(true);

    try {
      const res = await fetch("/api/consultar-pedido", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: searchQuery, phone }),
      });

      const data = await res.json();

      if (!res.ok) {
        setError(data.error ?? "Pedido não encontrado.");
        setLoading(false);
        return;
      }

      // Redireciona para a página do pedido encontrado
      router.push(`/pedido/${data.id}`);
    } catch {
      setError("Ocorreu um erro ao consultar. Tente novamente.");
      setLoading(false);
    }
  }

  return (
    <div className="mx-auto max-w-xl py-12 px-4">
      <div className="space-y-6 text-center">
        <div className="mx-auto grid h-20 w-20 place-items-center rounded-3xl border border-rose-100 bg-rose-50 text-rose-600 shadow-xl shadow-rose-600/10">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="h-10 w-10">
            <circle cx="11" cy="11" r="8" />
            <path d="M21 21l-4.3-4.3" />
          </svg>
        </div>

        <div>
          <span className="rounded-md bg-rose-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-rose-600">
            Acesso Seguro
          </span>
          <h1 className="font-display mt-2 text-3xl font-black text-slate-900 sm:text-4xl">
            Acompanhar Estado do Pedido
          </h1>
          <p className="mt-2 text-sm font-medium text-slate-600">
            Digite o número da sua encomenda e o telefone utilizado no momento da compra para verificar a sua reserva.
          </p>
        </div>

        <form onSubmit={handleSearch} className="space-y-4 text-left">
          <div className="space-y-1.5">
            <label className="block text-xs font-black uppercase tracking-wider text-slate-700">
              Número ou ID do Pedido *
            </label>
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Ex.: #1001 ou ID do pedido"
              className="w-full rounded-2xl border border-slate-200/80 bg-slate-50/80 px-4 py-3.5 text-sm font-bold text-slate-800 placeholder-slate-400 outline-none transition-all focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-500/10"
            />
          </div>

          <div className="space-y-1.5">
            <label className="block text-xs font-black uppercase tracking-wider text-slate-700">
              Telefone do Pedido *
            </label>
            <input
              type="tel"
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              placeholder="Ex.: 923 000 000"
              className="w-full rounded-2xl border border-slate-200/80 bg-slate-50/80 px-4 py-3.5 text-sm font-bold text-slate-800 placeholder-slate-400 outline-none transition-all focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-500/10"
            />
          </div>

          {error && (
            <p className="rounded-2xl border border-red-200 bg-red-50 p-3.5 text-xs font-bold text-red-700">
              ⚠️ {error}
            </p>
          )}

          <button
            type="submit"
            disabled={loading}
            className="flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-rose-600 to-rose-500 py-4 font-black text-white shadow-xl shadow-rose-600/30 transition-all hover:brightness-110 active:scale-98 disabled:opacity-50"
          >
            {loading ? (
              <>
                <span className="h-5 w-5 animate-spin rounded-full border-2 border-white border-t-transparent" />
                <span>A verificar dados...</span>
              </>
            ) : (
              <>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" className="h-5 w-5">
                  <circle cx="11" cy="11" r="8" />
                  <path d="M21 21l-4.3-4.3" />
                </svg>
                <span>Consultar Pedido</span>
              </>
            )}
          </button>
        </form>

        <div className="rounded-3xl border border-slate-200/80 bg-white p-5 text-left shadow-sm">
          <p className="text-xs text-slate-600 leading-relaxed font-medium">
            🔒 <strong>Privacidade garantida:</strong> Para proteção dos teus dados, a consulta só é exibida se o número do telefone coincidir com a encomenda registada.
          </p>
        </div>

        <Link
          href="/produtos"
          className="inline-block text-xs font-black uppercase tracking-wider text-slate-500 hover:text-slate-900 transition hover:underline"
        >
          ← Voltar ao catálogo de produtos
        </Link>
      </div>
    </div>
  );
}