import { notFound } from "next/navigation";
import Link from "next/link";
import { prisma } from "@/lib/prisma";
import { formatKz } from "@/lib/format";
import { PAYMENT_LABELS } from "@/lib/pdf";
import { whatsappLink } from "@/lib/site";

export const dynamic = "force-dynamic";

export default async function OrderPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  const order = await prisma.order.findUnique({
    where: { id },
    include: { items: true },
  });

  if (!order) notFound();

  const wa = whatsappLink();

  // Texto formatado para o WhatsApp com espaçamento correto
  const whatsappMessage = encodeURIComponent(
    `Olá! Acabei de fazer a encomenda #${order.orderNumber} no valor de ${formatKz(
      order.total
    )}. Gostaria de confirmar a entrega!`
  );

  return (
    <div className="mx-auto max-w-2xl space-y-6 px-4 pb-16 pt-4 sm:px-6">
      {/* BANNER DE SUCESSO VIBRANTE */}
      <div className="relative overflow-hidden rounded-3xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-500 p-6 text-center text-white shadow-2xl shadow-emerald-600/20 sm:p-8">
        <div className="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10 blur-2xl" />

        <span className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-3xl font-black text-emerald-600 shadow-lg sm:h-16 sm:w-16">
          ✓
        </span>

        <h1 className="font-display mt-4 text-2xl font-black sm:text-4xl">
          Pedido Confirmado com Sucesso!
        </h1>
        <p className="mt-2 text-xs font-semibold text-emerald-100 sm:text-sm">
          Número da Encomenda:{" "}
          <strong className="rounded-md bg-white/20 px-2.5 py-1 font-black text-white">
            #{order.orderNumber}
          </strong>
        </p>
      </div>

      {/* DETALHES DE ENTREGA & CONTACTO */}
      <div className="space-y-4 rounded-3xl border border-slate-200/80 bg-white p-5 shadow-xl shadow-slate-100/80 sm:p-6 text-sm">
        <div className="flex flex-col gap-2 border-b border-slate-100 pb-3 sm:flex-row sm:items-center sm:justify-between">
          <h2 className="font-display text-base font-black text-slate-900 sm:text-lg">
            Dados do Cliente & Entrega
          </h2>
          <span className="w-fit rounded-full bg-emerald-100 px-3 py-0.5 text-[11px] font-extrabold text-emerald-700">
            Aguardando Confirmação
          </span>
        </div>

        <div className="grid gap-3 pt-1 text-xs font-medium text-slate-700 sm:text-sm">
          <div className="flex justify-between gap-2">
            <span className="text-slate-500">Nome:</span>
            <strong className="text-right text-slate-900">{order.customerName}</strong>
          </div>
          <div className="flex justify-between gap-2">
            <span className="text-slate-500">Telefone:</span>
            <strong className="text-right text-slate-900">{order.phone}</strong>
          </div>
          <div className="flex justify-between gap-2">
            <span className="text-slate-500">Local de Entrega:</span>
            <strong className="text-right text-slate-900">{order.address}</strong>
          </div>
          <div className="flex justify-between gap-2">
            <span className="text-slate-500">Forma de Pagamento:</span>
            <strong className="text-right text-rose-600">
              {PAYMENT_LABELS[order.paymentMethod] ?? order.paymentMethod}
            </strong>
          </div>

          {order.notes && (
            <div className="mt-2 rounded-2xl border border-slate-100 bg-slate-50 p-3.5 text-xs text-slate-600">
              <strong className="mb-0.5 block text-slate-900">Observações:</strong>
              <p className="leading-relaxed">{order.notes}</p>
            </div>
          )}
        </div>
      </div>

      {/* RESUMO DOS ITENS */}
      <div className="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl shadow-slate-100/80">
        <div className="border-b border-slate-100 bg-slate-50/80 px-5 py-4 sm:px-6">
          <h2 className="font-display text-sm font-black text-slate-900 sm:text-base">
            Resumo dos Artigos
          </h2>
        </div>

        <ul className="divide-y divide-slate-100 text-xs font-medium sm:text-sm">
          {order.items.map((i) => (
            <li key={i.id} className="flex items-center justify-between gap-3 p-4 sm:p-5">
              <div className="flex items-center gap-3">
                <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-rose-100 font-black text-xs text-rose-600">
                  {i.quantity}×
                </span>
                <span className="font-bold text-slate-800">{i.name}</span>
              </div>
              <span className="shrink-0 font-black text-slate-900">
                {formatKz(i.unitPrice * i.quantity)}
              </span>
            </li>
          ))}
        </ul>

        <div className="flex items-center justify-between border-t-2 border-slate-100 bg-slate-50/50 p-5 sm:p-6">
          <span className="text-sm font-black text-slate-900 sm:text-base">Total do Pedido</span>
          <span className="font-display text-xl font-black text-rose-600 sm:text-2xl">
            {formatKz(order.total)}
          </span>
        </div>
      </div>

      {/* BOTÕES DE AÇÃO DESTACADOS */}
      <div className="space-y-3">
        {/* BOTÃO ENVIAR NO WHATSAPP */}
        <a
          href={`${wa}?text=${whatsappMessage}`}
          target="_blank"
          rel="noreferrer"
          className="flex w-full items-center justify-center gap-2.5 rounded-2xl bg-[#25D366] px-5 py-4 text-sm font-black text-white shadow-xl shadow-[#25D366]/20 transition-all hover:bg-[#22bf5b] active:scale-98"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="h-5 w-5 shrink-0">
            <path d="M4 5h16v11H9l-5 4z" />
          </svg>
          <span>Confirmar Pedido via WhatsApp</span>
        </a>

        {/* BOTÃO BAIXAR PDF */}
        <a
          href={`/api/pedidos/${order.id}/pdf`}
          className="flex w-full items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-5 py-3.5 text-sm font-bold text-slate-800 shadow-sm transition-all hover:border-slate-900 hover:bg-slate-900 hover:text-white"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="h-5 w-5 shrink-0">
            <path d="M7 3h7l5 5v13H7z" />
            <path d="M14 3v5h5M10 13h6M10 17h6" />
          </svg>
          <span>Descarregar Comprovativo em PDF</span>
        </a>
      </div>

      {/* RODAPÉ INFORMATIVO */}
      <div className="space-y-2 pt-2 text-center">
        <p className="text-xs font-semibold text-slate-500">
          Guarde o comprovativo PDF. A nossa equipa entrará em contacto no WhatsApp para agendar a entrega.
        </p>
        <Link
          href="/produtos"
          className="inline-block text-xs font-black uppercase tracking-wider text-rose-600 transition hover:underline"
        >
          ← Voltar à loja para ver mais peças
        </Link>
      </div>
    </div>
  );
}